# ==============================================================================
# PVE Dash Environment Configuration Template
# Copy to `.env` (for docker compose) or export in your systemd/shell environment.
# ==============================================================================

# Container timezone (used by Docker / Alpine tzdata)
TZ=Asia/Shanghai

# Host port published by docker-compose.yml (maps ${PVE_DASH_PORT}:8080)
PVE_DASH_PORT=8080

# HTTP listen address inside the process (use `:8080` in Docker or `127.0.0.1:8080` behind a local reverse proxy)
PVE_DASH_LISTEN=:8080

# Directory storing SQLite database (`pve-dash.db`) and auto-generated key files
PVE_DASH_DATA_DIR=./data

# Optional: 32-byte raw string or 64-char hex key (`openssl rand -hex 32`) for AES-256-GCM credential encryption.
# Leave empty to auto-generate and persist `${PVE_DASH_DATA_DIR}/.master.key` on first start.
PVE_DASH_MASTER_KEY=

# Optional: 32-byte raw string or 64-char hex key (`openssl rand -hex 32`) for signing session JWTs.
# Leave empty to auto-generate and persist `${PVE_DASH_DATA_DIR}/.jwt.key` on first start.
PVE_DASH_JWT_SECRET=

# Public external HTTPS origin (e.g. `https://pve-dash.example.com`).
# Used for CSRF/WebSocket origin validation, WebAuthn Passkey RP origin, and automatic Secure cookie flag.
PVE_DASH_PUBLIC_URL=

# Explicitly require `Secure` attribute on refresh cookies (`true` | `false`)
PVE_DASH_SECURE_COOKIE=false

# Trust `X-Forwarded-For` / `X-Real-IP` headers when deployed behind Nginx / Caddy / Traefik (`true` | `false`)
PVE_DASH_TRUST_PROXY=false

# Global server-enforced read-only inspection mode — rejects all mutating operations (`true` | `false`)
PVE_DASH_READ_ONLY=false

# Enable permissive localhost CORS for split frontend Vite dev server (`true` | `false`, never enable in production)
PVE_DASH_DEV_CORS=false
